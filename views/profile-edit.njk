{% extends "layout.njk" %}
{% block content %}
<div class="profile-container">
    <div class="profile-header">
        <h1>Modifier le profil</h1>
        <p>Gérez vos informations personnelles et vos paramètres de sécurité.</p>
    </div>

    <form action="/profile/edit" method="POST" class="profile-form">

        <!-- Informations Générales -->
        <div class="profile-section">
            <h3 class="section-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="var(--accent-primary)" stroke="var(--accent-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                Informations Générales
            </h3>
            <div class="form-row">
                <div class="input-group">
                    <label>Nom d'utilisateur</label>
                    <input type="text" name="username" value="{{ user.username }}" placeholder="Nom d'utilisateur" required>
                </div>
                <div class="input-group">
                    <label>Adresse mail</label>
                    <input type="email" name="email" value="{{ user.email }}" placeholder="Adresse mail" required>
                </div>
            </div>
            <div class="form-row">
                <div class="input-group" style="width: 100%;">
                    <label>Bio (votre cinéphilie en quelques mots)</label>
                    <textarea name="bio" rows="4" placeholder="Votre bio...">{{ user.bio if user.bio else '' }}</textarea>
                </div>
            </div>
        </div>

        <hr class="section-divider">

        <!-- Sécurité -->
        <div class="profile-section">
            <h3 class="section-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="var(--accent-primary)" stroke="var(--accent-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                Sécurité
            </h3>
            <div class="form-row">
                <div class="input-group" style="width: 100%;">
                    <label>Mot de passe actuel</label>
                    <input type="password" name="current_password" placeholder="Mot de passe actuel">
                </div>
            </div>
            <div class="form-row">
                <div class="input-group">
                    <label>Nouveau mot de passe</label>
                    <input type="password" name="new_password" placeholder="Nouveau mot de passe">
                </div>
                <div class="input-group">
                    <label>Confirmer le nouveau mot de passe</label>
                    <input type="password" name="confirm_password" placeholder="Confirmer le nouveau mot de passe">
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Enregistrer les modifications</button>
        </div>
    </form>
</div>
{% endblock %}
