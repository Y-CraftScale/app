{% extends "layout.njk" %}
{% block content %}
<div class="admin-profile-container" style="max-width: 1000px; margin: 2rem auto; padding: 0 1rem;">
    <!-- Headings -->
    <div style="text-align: center; margin-bottom: 3rem;">
        <h1 style="font-size: 2.5rem; font-weight: 800;">Admin</h1>
    </div>

    <!-- Profile Info Area -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem;">
        <div style="display: flex; align-items: center; gap: 1.5rem;">
            <div style="width: 100px; height: 100px; border-radius: 50%; background-color: var(--accent-primary);"></div>
            <div>
                <h2 style="margin: 0; font-size: 1.2rem; font-weight: 500;">{{ user.username if user else 'Jean Martin' }}</h2>
                <p style="margin: 0; color: var(--accent-primary); font-size: 0.9rem;">membre depuis janvier 2024</p>
            </div>
        </div>
        <div>
            <a href="/profile/edit" class="btn-filled" style="padding: 0.6rem 1.5rem; border-radius: 4px; font-size: 0.9rem;">Modifier le profil</a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div style="display: flex; gap: 2rem; margin-bottom: 3rem;">
        <!-- Card 1 -->
        <div style="background-color: #1a1a1a; padding: 1.5rem; border-radius: 12px; flex: 1; max-width: 300px; border: 1px solid #333;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <span style="color: #ccc; font-size: 0.95rem;">Nombre d'inscription</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="var(--accent-primary)" stroke="var(--accent-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <div style="display: flex; align-items: baseline; gap: 1rem;">
                <span style="font-size: 2.2rem; font-weight: bold; color: white;">{{ stats.totalUsers }}</span>
                <span style="color: var(--accent-primary); font-size: 0.85rem; font-weight: 600;">+{{ stats.newUsersThisMonth }} ce mois</span>
            </div>
        </div>
        
        <!-- Card 2 -->
        <div style="background-color: #1a1a1a; padding: 1.5rem; border-radius: 12px; flex: 1; max-width: 300px; border: 1px solid #333;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <span style="color: #ccc; font-size: 0.95rem;">Commentaires</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="var(--accent-primary)" stroke="var(--accent-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
            </div>
            <div style="display: flex; align-items: baseline; gap: 1rem;">
                <span style="font-size: 2.2rem; font-weight: bold; color: white;">{{ stats.totalComments }}</span>
                <span style="color: var(--accent-primary); font-size: 0.85rem; font-weight: 600;">+{{ stats.newCommentsThisMonth }} ce mois</span>
            </div>
        </div>
    </div>

    <!-- Tabs Menu -->
    <div style="border-bottom: 1px solid #333; margin-bottom: 2rem; display: flex; gap: 2rem;">
        <div style="padding-bottom: 1rem; border-bottom: 2px solid var(--accent-primary); color: var(--accent-primary); font-weight: 500; cursor: pointer;">
            En attente
        </div>
        <div style="padding-bottom: 1rem; color: #ccc; cursor: pointer; transition: color 0.2s;">
            Watchlist
        </div>
        <div style="padding-bottom: 1rem; color: #ccc; cursor: pointer; transition: color 0.2s;">
            Watched list
        </div>
    </div>

    <!-- SECTION COMMENTAIRES -->
    <section>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h2 style="font-size: 1.2rem; font-weight: 600; margin: 0;">En attente de validation</h2>
            <a href="#" style="color: var(--accent-primary); font-size: 0.9rem; text-decoration: none;">Tout voir</a>
        </div>
        <div style="background-color: #0a0a0a; border-radius: 12px; border: 1px solid #333; padding-bottom: 1.5rem;">
            <table class="moderation-table">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Commentaire</th>
                        <th>Film</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if comments and comments.length > 0 %}
                        {% for comment in comments.slice(0, 5) %}
                            <tr>
                                <td>
                                    <div class="mod-user-col">
                                        <div class="mod-avatar"></div>
                                        <div class="mod-user-info">
                                            <p class="mod-username">{{ comment.username }}</p>
                                            <p class="mod-date">Aujourd'hui, {{ comment.created_at | string | truncate(5, true, "") if comment.created_at else "10:24" }}</p>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <p class="mod-comment">
                                        {{ comment.content | truncate(80) }}
                                    </p>
                                </td>
                                <td>
                                    <span class="mod-movie-pill">{{ comment.movie_title }}</span>
                                </td>
                                <td>
                                    <div class="mod-actions">
                                        <form action="/admin/comment/approve/{{ comment.id }}" method="POST" style="margin: 0;">
                                            <button type="submit" class="btn-approve">Aprouver</button>
                                        </form>
                                        <form action="/admin/comment/delete/{{ comment.id }}" method="POST" style="margin: 0;" onsubmit="return confirm('Supprimer définitivement ce commentaire ?');">
                                            <button type="submit" class="btn-reject">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 3rem; color: #666; font-style: italic;">Aucun commentaire en attente.</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
            
            {% if comments and comments.length > 0 %}
            <div style="display: flex; justify-content: flex-end; padding: 1.5rem 2rem 0; gap: 1rem; align-items: center;">
                <button style="background: transparent; border: 1px solid #333; color: white; width: 40px; height: 40px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">&lt;</button>
                <div style="display: flex; gap: 1rem; align-items: center; font-weight: 500;">
                    <button style="background: var(--accent-primary); border: none; color: white; width: 40px; height: 40px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 1.1rem;">1</button>
                    <button style="background: transparent; border: none; color: white; width: 40px; height: 40px; cursor: pointer; font-size: 1.1rem; transition: color 0.2s;">2</button>
                    <button style="background: transparent; border: none; color: white; width: 40px; height: 40px; cursor: pointer; font-size: 1.1rem; transition: color 0.2s;">3</button>
                </div>
                <button style="background: transparent; border: 1px solid #333; color: white; width: 40px; height: 40px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">&gt;</button>
            </div>
            {% endif %}
        </div>
    </section>

</div>
{% endblock %}