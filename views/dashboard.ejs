<div class="dashboard-header auth-container" style="margin-top: 2rem; margin-bottom: 3rem; padding: 2rem;">
    <h1>Mon Profil</h1>
    <p><strong>Pseudo:</strong> <%= locals.user.username %></p>
    <p><strong>Email:</strong> <%= locals.user.email %></p>
    <% if (locals.user.bio) { %>
        <p><strong>Bio:</strong> <%= locals.user.bio %></p>
    <% } else { %>
        <p><em>Aucune bio renseignée.</em></p>
    <% } %>
    <a href="/profile/edit" class="btn-primary" style="display: inline-block; text-align: center;">Modifier mon profil</a>
</div>

<div class="lists-container">
    <section class="movie-section">
        <h2>📌 Ma Watchlist (À voir)</h2>
        <div class="movie-grid">
            <% if (locals.watchlist && watchlist.length > 0) { %>
                <% watchlist.forEach(movie => { %>
                    <div class="movie-card">
                        <a href="/movie/<%= movie.movie_id %>">
                            <% if (movie.poster_path) { %>
                                <img src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>" alt="<%= movie.title %>">
                            <% } else { %>
                                <div class="no-poster"><%= movie.title %></div>
                            <% } %>
                            <div class="movie-info">
                                <h3><%= movie.title %></h3>
                            </div>
                        </a>
                        <div style="padding: 0 1rem 1rem;">
                            <form action="/movie/watched/add" method="POST" style="margin-bottom: 0.5rem;">
                                <input type="hidden" name="movieId" value="<%= movie.movie_id %>">
                                <button type="submit" class="btn-primary" style="width: 100%; font-size: 0.8rem; padding: 0.5rem;">👁️ Marquer comme vu</button>
                            </form>
                            <form action="/movie/remove" method="POST">
                                <input type="hidden" name="movieId" value="<%= movie.movie_id %>">
                                <button type="submit" class="btn-primary" style="width: 100%; background-color: var(--danger); font-size: 0.8rem; padding: 0.5rem;">❌ Retirer</button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>Votre Watchlist est vide. Allez chercher de nouveaux films !</p>
            <% } %>
        </div>
    </section>

    <section class="movie-section" style="margin-top: 4rem;">
        <h2>👁️ Films déjà vus</h2>
        <div class="movie-grid">
            <% if (locals.watchedMovies && watchedMovies.length > 0) { %>
                <% watchedMovies.forEach(movie => { %>
                    <div class="movie-card">
                        <a href="/movie/<%= movie.movie_id %>">
                            <% if (movie.poster_path) { %>
                                <img src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>" alt="<%= movie.title %>" style="opacity: 0.7;">
                            <% } else { %>
                                <div class="no-poster"><%= movie.title %></div>
                            <% } %>
                            <div class="movie-info">
                                <h3><%= movie.title %></h3>
                            </div>
                        </a>
                        <div style="padding: 0 1rem 1rem;">
                            <form action="/movie/remove" method="POST">
                                <input type="hidden" name="movieId" value="<%= movie.movie_id %>">
                                <button type="submit" class="btn-primary" style="width: 100%; background-color: var(--danger); font-size: 0.8rem; padding: 0.5rem;">❌ Oublier ce film</button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>Vous n'avez pas encore marqué de films comme vus.</p>
            <% } %>
        </div>
    </section>
</div>