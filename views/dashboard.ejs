<div class="profile-container" style="max-width: 1000px; margin: 0 auto; padding: 2rem 4%;">
    <h1 style="text-align: center; font-size: 2.5rem; margin-bottom: 3rem;">Mon profil</h1>

    <div class="profile-header"
        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem;">
        <div style="display: flex; align-items: center; gap: 1.5rem;">
            <div style="width: 80px; height: 80px; background-color: var(--accent-primary); border-radius: 50%;"></div>
            <div>
                <h2 style="font-size: 1.5rem; margin-bottom: 0.2rem;">
                    <%= locals.user.username %>
                </h2>
                <div style="color: var(--accent-primary); font-size: 0.9rem;">membre depuis 2024</div>
            </div>
        </div>
        <a href="/profile/edit" class="btn-filled">Modifier le profil</a>
    </div>

    <div class="stats-cards" style="display: flex; gap: 2rem; margin-bottom: 4rem;">
        <div
            style="flex: 1; background-color: var(--surface-color); padding: 1.5rem 2rem; border-radius: 12px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="color: var(--text-secondary); margin-bottom: 0.5rem;">Films vus</div>
                <div style="font-size: 2rem; font-weight: 800;">
                    <%= locals.watchedMovies ? locals.watchedMovies.length : 0 %>
                </div>
            </div>
            <div style="color: var(--accent-primary); font-size: 1.5rem; display: flex; align-items: center;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </div>
        </div>

        <div
            style="flex: 1; background-color: var(--surface-color); padding: 1.5rem 2rem; border-radius: 12px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="color: var(--text-secondary); margin-bottom: 0.5rem;">Watchlist</div>
                <div style="font-size: 2rem; font-weight: 800;">
                    <%= locals.watchlist ? locals.watchlist.length : 0 %>
                </div>
            </div>
            <div style="color: var(--accent-primary); font-size: 1.5rem; display: flex; align-items: center;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                </svg>
            </div>
        </div>
    </div>

    <div class="tabs-navigation"
        style="display: flex; gap: 2rem; border-bottom: 1px solid var(--border-color); margin-bottom: 2rem;">
        <h3
            style="color: var(--accent-primary); border-bottom: 2px solid var(--accent-primary); padding-bottom: 0.5rem; cursor: pointer;">
            Films À Voir (Watchlist)</h3>
    </div>

    <div class="lists-container">
        <section class="movie-section">
            <div class="movie-grid" style="grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));">
                <% if (locals.watchlist && watchlist.length> 0) { %>
                    <% watchlist.forEach(movie=> { %>
                        <div class="movie-card" style="border: none; background: transparent;">
                            <a href="/movie/<%= movie.movie_id %>">
                                <% if (movie.poster_path) { %>
                                    <img src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>"
                                        alt="<%= movie.title %>" style="border-radius: 12px;">
                                    <% } else { %>
                                        <div class="no-poster" style="border-radius: 12px;">
                                            <%= movie.title %>
                                        </div>
                                        <% } %>
                            </a>
                            <div style="padding: 1rem 0;">
                                <form action="/movie/watched/add" method="POST" style="margin-bottom: 0.5rem;">
                                    <input type="hidden" name="movieId" value="<%= movie.movie_id %>">
                                    <button type="submit" class="btn-outline"
                                        style="width: 100%; font-size: 0.8rem; padding: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.25rem;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                        Vu
                                    </button>
                                </form>
                                <form action="/movie/remove" method="POST">
                                    <input type="hidden" name="movieId" value="<%= movie.movie_id %>">
                                    <button type="submit" class="btn-outline"
                                        style="width: 100%; border-color: var(--border-color); color: var(--text-secondary); font-size: 0.8rem; padding: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.25rem;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                        Retirer
                                    </button>
                                </form>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <p style="color: var(--text-secondary);">Votre Watchlist est vide. Allez chercher de
                                    nouveaux films !</p>
                                <% } %>
            </div>
        </section>

        <div class="tabs-navigation"
            style="display: flex; gap: 2rem; border-bottom: 1px solid var(--border-color); margin-top: 4rem; margin-bottom: 2rem;">
            <h3
                style="color: var(--accent-primary); border-bottom: 2px solid var(--accent-primary); padding-bottom: 0.5rem; cursor: pointer;">
                Historique (Films déjà vus)</h3>
        </div>

        <section class="movie-section">
            <div class="movie-grid" style="grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));">
                <% if (locals.watchedMovies && watchedMovies.length> 0) { %>
                    <% watchedMovies.forEach(movie=> { %>
                        <div class="movie-card" style="border: none; background: transparent;">
                            <a href="/movie/<%= movie.movie_id %>">
                                <% if (movie.poster_path) { %>
                                    <img src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>"
                                        alt="<%= movie.title %>" style="border-radius: 12px; opacity: 0.8;">
                                    <% } else { %>
                                        <div class="no-poster" style="border-radius: 12px;">
                                            <%= movie.title %>
                                        </div>
                                        <% } %>
                            </a>
                            <div style="padding: 1rem 0;">
                                <form action="/movie/remove" method="POST">
                                    <input type="hidden" name="movieId" value="<%= movie.movie_id %>">
                                    <button type="submit" class="btn-outline"
                                        style="width: 100%; border-color: var(--border-color); color: var(--text-secondary); font-size: 0.8rem; padding: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.25rem;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                        Oublier
                                    </button>
                                </form>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <p style="color: var(--text-secondary);">Vous n'avez pas encore marqué de films comme
                                    vus.</p>
                                <% } %>
            </div>
        </section>
    </div>
</div>