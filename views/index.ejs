<div class="home-container">
    <section class="movie-section">
        <h2>🔥 Tendances de la semaine</h2>
        <div class="movie-grid">
            <% if (locals.trendingMovies && trendingMovies.length > 0) { %>
                <% trendingMovies.forEach(movie => { %>
                    <a href="/movie/<%= movie.id %>" class="movie-card">
                        <% if (movie.poster_path) { %>
                            <img src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>" alt="<%= movie.title %>">
                        <% } else { %>
                            <div class="no-poster"><%= movie.title %></div>
                        <% } %>
                        <div class="movie-info">
                            <h3><%= movie.title %></h3>
                            <span class="rating">⭐ <%= movie.vote_average.toFixed(1) %></span>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <p>Aucune tendance disponible.</p>
            <% } %>
        </div>
    </section>

    <section class="movie-section">
        <h2>⭐️ Les mieux notés</h2>
        <div class="movie-grid">
            <% if (locals.topRatedMovies && topRatedMovies.length > 0) { %>
                <% topRatedMovies.forEach(movie => { %>
                    <a href="/movie/<%= movie.id %>" class="movie-card">
                        <% if (movie.poster_path) { %>
                            <img src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>" alt="<%= movie.title %>">
                        <% } else { %>
                            <div class="no-poster"><%= movie.title %></div>
                        <% } %>
                        <div class="movie-info">
                            <h3><%= movie.title %></h3>
                            <span class="rating">⭐ <%= movie.vote_average.toFixed(1) %></span>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <p>Aucun film disponible.</p>
            <% } %>
        </div>
    </section>
</div>