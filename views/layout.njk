<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}CineAddict{% endblock %}</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header class="navbar">
        <a href="/" class="nav-brand">CineAddict</a>
        <nav class="nav-container">
            <form action="/search" method="GET" class="search-form">
                <input type="text" name="q" placeholder="Rechercher un film..." required>
                <button type="submit">🔍</button>
            </form>
            <a href="/">Accueil</a>
            <a href="/users/search" style="margin-left: 1rem;">Communauté</a>
            
            {# Gestion de la session utilisateur #}
            {% if user %}
                <a href="/dashboard" class="btn-primary" style="margin-left: 1rem;">Mon Profil ({{ user.username }})</a>
                {% if user.is_admin %}
                    <a href="/admin" class="btn-primary" style="margin-left: 1rem; background-color: #e50914;">⚙️ Administration</a>
                {% endif %}
                <a href="/logout" style="margin-left: 1rem;">Déconnexion</a>
            {% else %}
                <a href="/login" style="margin-left: 1rem;">Connexion</a>
                <a href="/register" style="margin-left: 1rem;">Inscription</a>
            {% endif %}
        </nav>
    </header>

    <main class="main-content">
        {# Messages d'alerte (Flash messages) #}
        {% if error_msg and error_msg.length > 0 %}
            <div class="alert alert-error">{{ error_msg }}</div>
        {% endif %}
        
        {% if success_msg and success_msg.length > 0 %}
            <div class="alert alert-success">{{ success_msg }}</div>
        {% endif %}

        {# Emplacement où le contenu des autres pages sera injecté #}
        {% block content %}{% endblock %}
    </main>

    <footer>
        <p>&copy; 2026 CineAddict. Tous droits réservés.</p>
    </footer>

    <script src="/js/script.js"></script>
    {% block extra_js %}{% endblock %}
</body>

</html>