<div class="search-header" style="text-align: center; margin: 3rem 0;">
    <h1>Rechercher des membres CineAddict</h1>
    <form action="/users/search" method="GET" class="search-form" style="justify-content: center;">
        <input type="text" name="q" placeholder="Pseudo d'un ami..." value="<%= locals.query || '' %>" required style="width: 50%; max-width: 400px; padding: 1rem; border-radius: 4px; border: none; font-size: 1rem;">
        <button type="submit" class="btn-primary" style="padding: 1rem 2rem;">Rechercher</button>
    </form>
</div>

<section class="movie-section" style="max-width: 800px; margin: 0 auto;">
    <% if (locals.query && locals.users) { %>
        <h2>Résultats pour "<%= query %>"</h2>
        
        <% if (users.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem;">
                <% users.forEach(user => { %>
                    <div style="background-color: #111; padding: 1.5rem; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; border: 1px solid #333;">
                        <div>
                            <h3 style="margin: 0; font-size: 1.5rem; color: var(--accent-blue);"><%= user.username %></h3>
                            <p style="margin: 0.5rem 0 0; color: #888; font-size: 0.9rem;"><%= user.bio ? user.bio.substring(0, 100) + '...' : 'Aucune bio renseignée.' %></p>
                        </div>
                        <a href="/user/<%= user.id %>" class="btn-primary">Voir le Profil</a>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="auth-container" style="text-align: center;">
                <p>Aucun utilisateur trouvé avec ce pseudo. 😢</p>
            </div>
        <% } %>
    <% } %>
</section>
